# ARMOR-RADAR defaults. Copyright (C) 2026 JuanenRac (Electro Hobby 3D). GPL-3.0-or-later.
#
# The three radars need all three UARTs, and UART0 is the default console. Move the
# console to the native USB Serial/JTAG peripheral so UART0 is free for a radar. On the
# Waveshare ESP32-S3-ETH the USB-C connector is the native USB port, and on the ESP32-S3-WROOM-1
# N16R8 board its "USB & OTG" socket is: the serial log comes out of the same cable used to flash it.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Show the node's own log lines at the default level; the drivers stay quiet unless they warn.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# A wired node that stops answering must recover by itself: the task watchdog resets a stuck task.
CONFIG_ESP_TASK_WDT_EN=y
# The board-specific options (the W5500 Ethernet controller, the bridge) are in sdkconfig.board.s3-eth; tools/build_node.sh adds the one of the board.

# The board has 16 MB of flash: two application slots for over-the-air updates (partitions.csv), and the boot loader goes back to the
# previous image when a new one does not confirm itself.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The ESP32-S3R8 carries 8 MB of octal PSRAM. If it does not answer the node still starts, without it (a wrong guess must not brick a board).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_LWIP_MAX_SOCKETS=16
# The HTTPS panel: a second server with its own certificate; the TLS buffers are released while a connection is idle.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Bluetooth Low Energy (NimBLE) is only the peripheral side, for configuring a node from a phone (docs/BLE_PROVISIONING.md); it is started only when the
# node's settings say so. No bonding is kept, one connection at a time.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
