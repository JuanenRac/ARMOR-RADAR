# ARMOR-RADAR - the FIRST settings of one node. Copy to secrets/<node-id>.conf and edit (that copy is git-ignored).
# tools/provision_node.sh does this for you: it asks the broker for the password and makes the setup code.
#
# These values only seed a freshly flashed node. After the first start the node's own web panel holds its settings (address, Wi-Fi,
# broker, radars, pins, users) in flash, and this file no longer matters to that node. A build with none of the identity lines is a
# generic image that is configured entirely from the panel.

CONFIG_ARMOR_NODE_ID="perimetro-1"
CONFIG_ARMOR_MQTT_URI="mqtt://192.168.0.180:18883"
CONFIG_ARMOR_MQTT_USERNAME="field-node-perimetro-1"
CONFIG_ARMOR_MQTT_PASSWORD="the password printed once by mqtt_identity.sh"

# The code that lets the first administrator be created from the node's panel (8 to 32 characters). Empty: a new random code at every
# start, shown on the USB console every 15 seconds.
CONFIG_ARMOR_SETUP_CODE="K7M2QX9PTR"

# Radars connected to this node (0 to 3), and the light sensor.
CONFIG_ARMOR_RADAR_COUNT=3
CONFIG_ARMOR_LIGHT_VEML7700=y

# BENCH ONLY, without the light sensor: a fixed value in lux sent in every message. Leave out for a real installation.
# CONFIG_ARMOR_LIGHT_VEML7700=n
# CONFIG_ARMOR_LUX_FALLBACK=300

# The first day on the bench: log the raw frames of every radar (see docs/BENCH_BRINGUP.md).
# CONFIG_ARMOR_RADAR_HEX_DUMP=y
